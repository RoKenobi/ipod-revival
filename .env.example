# Everything below is OPTIONAL — the app runs with zero configuration if
# yt-dlp and ffmpeg are already on your PATH. Copy this file to `.env` and
# uncomment/fill in only what you actually need to override.

# HOST=127.0.0.1
# PORT=4445
# DOWNLOAD_FOLDER=C:\Music\iPodJukebox

# Only needed if yt-dlp / ffmpeg aren't on your PATH
# YT_DLP_PATH=C:\path\to\yt-dlp.exe
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Optional "import a playlist directly, no CSV needed" feature.
# Register a free app at https://developer.spotify.com/dashboard
# and set its Redirect URI to exactly:
#   http://127.0.0.1:4445/api/spotify/callback
# (match the port above if you changed PORT)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
